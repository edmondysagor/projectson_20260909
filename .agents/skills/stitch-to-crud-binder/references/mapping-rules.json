{
  "description": "Rules and conventions for mapping Google Stitch UI components to Neon DB columns and backend APIs",
  "conventions": {
    "casing": {
      "database": "snake_case (e.g. user_id, created_at, is_active)",
      "backend_api_payload": "snake_case or camelCase with explicit DTO mapper",
      "frontend_react": "camelCase (e.g. userId, createdAt, isActive)"
    },
    "standard_columns": {
      "id": "UUID PRIMARY KEY DEFAULT gen_random_uuid()",
      "created_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()",
      "updated_at": "TIMESTAMP WITH TIME ZONE DEFAULT NOW()"
    },
    "required_ui_states": [
      "loading (skeleton/spinner)",
      "error (toast/alert banner)",
      "empty (placeholder illustration)",
      "mutating (disable submit button during request)"
    ]
  },
  "crud_template": {
    "create": {
      "method": "POST",
      "status": 201,
      "optimistic_support": true
    },
    "read": {
      "method": "GET",
      "status": 200,
      "pagination": true
    },
    "update": {
      "method": "PATCH",
      "status": 200,
      "partial_allowed": true
    },
    "delete": {
      "method": "DELETE",
      "status": 200,
      "confirmation_required": true
    }
  }
}
